# Copiar a .env y ajustar valores (no subir .env a Git)
POSTGRES_USER=congreso
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=archivo_congreso
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://congreso:cambiar_en_produccion@postgres:5432/archivo_congreso

# Opcional: clave para tokens de sesión
# TOKEN_SECRET=generar_una_clave_larga_y_aleatoria
